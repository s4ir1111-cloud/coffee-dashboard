{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "garden-guest-cdp-secure",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-04",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "garden-guest-cdp",
      "database_id": "f974ab23-e762-42e0-9bae-cf259bde72e8",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
